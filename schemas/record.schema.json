{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "small",
            "standard",
            "large"
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxConcurrent": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxAttempts": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxDepth": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxTasks": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "budgetUnits": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxConcurrent",
            "maxAttempts",
            "maxDepth",
            "maxTasks",
            "budgetUnits"
          ],
          "additionalProperties": false
        },
        "unitDescription": {
          "type": "string",
          "minLength": 1
        },
        "actors": {
          "minItems": 2,
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "general",
                  "subcontractor",
                  "lead",
                  "worker",
                  "inspector"
                ]
              },
              "parent": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "responsibility": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "role",
              "responsibility"
            ],
            "additionalProperties": false
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contractor": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "taskIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                }
              },
              "requestedWorkers": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "design": {
                "type": "string",
                "minLength": 1
              },
              "interfaceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "contractor",
              "taskIds",
              "requestedWorkers",
              "rationale",
              "design",
              "interfaceRefs",
              "risks"
            ],
            "additionalProperties": false
          }
        },
        "integrationDecision": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "minItems": 1,
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                }
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "acceptance": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "units": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "priority": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "title",
              "owner",
              "dependsOn",
              "resources",
              "acceptance",
              "units",
              "priority"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "objective",
        "exclusions",
        "mode",
        "limits",
        "unitDescription",
        "actors",
        "proposals",
        "integrationDecision",
        "tasks"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "planHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "actor": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "revoke"
            ]
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?Z$"
              }
            ]
          }
        },
        "required": [
          "planHash",
          "actor",
          "decision",
          "sourceRef",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "attempt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "actor": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "submitted",
              "failed",
              "cancelled"
            ]
          },
          "startedAt": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?Z$"
              }
            ]
          },
          "endedAt": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?Z$"
              }
            ]
          },
          "unitsUsed": {
            "type": "number",
            "minimum": 0
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "dependencyArtifacts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "task",
          "attempt",
          "actor",
          "state",
          "startedAt",
          "dependencyArtifacts"
        ],
        "additionalProperties": false
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "attempt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "self",
              "independent"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "at": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?Z$"
              }
            ]
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "task",
          "attempt",
          "artifact",
          "reviewer",
          "kind",
          "verdict",
          "at",
          "evidence",
          "findings"
        ],
        "additionalProperties": false
      }
    },
    "coordinationSessions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
      }
    }
  },
  "required": [
    "plan",
    "approvals",
    "runs",
    "inspections",
    "coordinationSessions"
  ],
  "additionalProperties": false
}
